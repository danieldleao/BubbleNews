# ==============================================================================
# BUBBLE NEWS — Version 0.1 Beta .gitignore
# Prevents accidental commitment of private credentials, logs, and local caches
# ==============================================================================

# Private local configuration (Contains SMTP passwords and Gemini API keys)
.bubble_news_config.json
*.private.json
.env
*.env

# Execution and error logs
*.log
bubble_news.log

# Generated test and dry-run email outputs
preview_*.html
test_output_*.html
*.html_preview

# Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# IDE and Editor settings
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
