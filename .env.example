# ==============================================================================
# BUBBLE NEWS — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# 1. EMAIL DELIVERY (Disroot SMTP)
EMAIL_ADDRESS=your-email@disroot.org
EMAIL_PASSWORD=YOUR_EMAIL_PASSWORD
SMTP_SERVER=disroot.org
SMTP_PORT=587

# 2. AI ENGINE (Google Gemini)
# Obtain your free API key at https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# 3. SCHEDULE & RUNTIME SETTINGS
SCHEDULE_TIME=08:00
FEEDS_FILE=bubble_news.json
TIME_WINDOW_HOURS=12
LOG_FILE=bubble_news.log
